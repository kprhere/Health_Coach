# Copy to .env.local (gitignored) for local use. NEVER commit real values.

# Browser (Vite) -- safe to expose; protected by RLS
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Admin scripts only (scripts/account.mjs, backup-cloud.mjs, restore-cloud.mjs).
# The service role key bypasses RLS: keep it in your shell, never in Vercel/browser.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
MAX_USERS=5

# Edge Function secrets are set with `supabase secrets set`, not in a file:
#   AI_BASE_URL, AI_API_KEY, AI_MODEL
